# Copy to ~/.comics8-deploy.env on the Linux deploy host.

# Android release signing (required by deploy-release.sh).
# Keep the keystore outside this repository and rotate any key that was committed.
COMICS8_SIGNING_STORE_FILE=/secure/path/comics8-release.keystore
COMICS8_SIGNING_STORE_PASSWORD=change-me
COMICS8_SIGNING_KEY_ALIAS=comics8
COMICS8_SIGNING_KEY_PASSWORD=change-me

# GitHub Releases & Sync Server
# COMICS8_SERVER_HOST=192.168.0.136
# COMICS8_SERVER_USER=crudust
# COMICS8_PUBLIC_REPO_URL=git@github.com:crudust/comics8.git
