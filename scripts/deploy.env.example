# Copy to ~/.comics8-deploy.env on the Linux deploy host.
# Mac: System Settings → General → Sharing → Remote Login (SSH) on,
# then add this machine's ~/.ssh/id_ed25519.pub to the Mac authorized_keys.
COMICS8_MAC_SSH=crudust@192.168.0.94
COMICS8_MAC_BUILD_DIR=/Users/crudust/Documents/Mac/Comics8
COMICS8_MAC_REPO_URL=git@github.com:crudust/Comics8.git

# GitHub Releases (Optional: set to auto-publish releases)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=crudust/comics8
# COMICS8_PUBLIC_REPO_URL=git@github.com:crudust/comics8-desktop.git

