{
  "name": "comics8-web-extension",
  "private": true,
  "version": "0.2.48",
  "type": "module",
  "description": "Comics8 browser extension: JS source plugins, local/WebDAV storage, sync client and web reader",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:builtin": "node scripts/sync-builtin-sources.mjs",
    "sync:builtin:check": "node scripts/sync-builtin-sources.mjs --check",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:views": "vitest run --config vitest.views.config.ts",
    "test:state": "vitest run --config vitest.state.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.31",
    "@types/node": "^22.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.11",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.4"
  }
}
