{
  "name": "comics8-web-extension",
  "private": true,
  "version": "0.2.52",
  "type": "module",
  "description": "Comics8 browser extension: JS source plugins, local/WebDAV storage, sync client and web reader",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:builtin": "node scripts/sync-builtin-sources.mjs",
    "sync:builtin:check": "node scripts/sync-builtin-sources.mjs --check",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:views": "vitest run --config vitest.views.config.ts",
    "test:state": "vitest run --config vitest.state.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "fflate": "^0.8.3",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@xmldom/xmldom": "^0.9.12",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.14",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
